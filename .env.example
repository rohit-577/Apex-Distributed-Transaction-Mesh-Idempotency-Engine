# Copy this file to `.env` and adjust for local development.
# `.env` itself is gitignored and must never be committed.
#
# The C++ application does NOT read this file directly. It reads the
# APEX_* variables documented in README.md. Keep the two sets consistent
# when running the app against `docker compose` infrastructure.

POSTGRES_USER=apex
POSTGRES_PASSWORD=apex-dev-only
POSTGRES_DB=apex
POSTGRES_PORT=5432

REDIS_PORT=6379
